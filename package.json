{
  "name": "sashkode",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "build:ts-plugin": "tsc -p plugins/typescript/next-safe-page/tsconfig.json",
    "predev:ssl": "./config/ssl/trust.sh",
    "dev:ssl": "next dev --experimental-https --experimental-https-ca ./config/ssl/certificates/RootCA.crt --experimental-https-key ./config/ssl/certificates/localhost.key --experimental-https-cert ./config/ssl/certificates/localhost.crt"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.2.1",
    "fumadocs-mdx": "^14.0.4",
    "fumadocs-ui": "^16.2.1",
    "lucide-react": "^0.555.0",
    "nanoid": "^5.1.6",
    "next": "16.0.5",
    "next-safe-action": "^8.0.11",
    "pino": "^10.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "pino-pretty": "^13.1.2",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-next-safe-page": "file:./plugins/typescript/next-safe-page"
  }
}
