# YouTube Integration
YOUTUBE_API_KEY= # Get your YouTube API key from Google Cloud Console > APIs & Services > Credentials
YOUTUBE_WEBHOOK_SECRET= # Generate a strong secret for verifying YouTube webhook signatures
YOUTUBE_CHANNEL_ID= # Your YouTube channel ID
YOUTUBE_CLIENT_ID=# Get these from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
YOUTUBE_CLIENT_SECRET= # Get these from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
YOUTUBE_REFRESH_TOKEN= # Run: YOUTUBE_CLIENT_ID=xxx YOUTUBE_CLIENT_SECRET=xxx npx tsx scripts/youtube-oauth-setup.ts

# GitHub Integration  
GITHUB_TOKEN= # Generate a GitHub Personal Access Token with appropriate scopes (Read access to metadata, Read and Write access to actions, code, issues, and pull requests)

# API Authentication
ADMIN_API_KEY= # Generate a strong API key for admin operations

# Vercel
CRON_SECRET= # Generate a strong secret for cron job authentication
VERCEL_WEBHOOK_SECRET= # Add Vercel webhook: In Vercel Dashboard → Project Settings → Webhooks (Then copy the secret here)

# Application
APP_URL= # e.g., https://yourdomain.com