{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 320
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noProcessEnv": "error",
        "useImportType": "error",
        "noDefaultExport": "error",
        "noNegationElse": "error",
        "noEnum": "error",
        "noImplicitBoolean": "error",
        "noInferrableTypes": "error",
        "noYodaExpression": "error"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        "noConsole": "warn"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "noUnnecessaryConditions": "error",
        "useExhaustiveSwitchCases": "error",
        "useReactFunctionComponents": "error",
        "useSortedClasses": {
          "options": {},
          "level": "error",
          "fix": "safe"
        }
      },
      "correctness": {
        "noUnusedImports": {
          "options": {},
          "level": "error",
          "fix": "safe"
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteProperties": "asNeeded",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              { "type": false, "source": ":NODE:" },
              { "type": true, "source": ":NODE:" },
              ":BLANK_LINE:",
              { "type": false, "source": ["next", "next/**"] },
              { "type": true, "source": ["next", "next/**"] },
              { "type": false, "source": ["react", "react/**", "react-*"] },
              { "type": true, "source": ["react", "react/**", "react-*"] },
              ":BLANK_LINE:",
              { "type": false, "source": ":PACKAGE:" },
              { "type": false, "source": ":PACKAGE_WITH_PROTOCOL:" },
              { "type": true, "source": ":PACKAGE:" },
              { "type": true, "source": ":PACKAGE_WITH_PROTOCOL:" },
              ":BLANK_LINE:",
              { "type": false, "source": ":ALIAS:" },
              { "type": true, "source": ":ALIAS:" },
              ":BLANK_LINE:",
              { "type": false, "source": ":PATH:" },
              { "type": true, "source": ":PATH:" }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/page.tsx",
        "**/layout.tsx",
        "**/template.tsx",
        "**/error.tsx",
        "**/global-error.tsx",
        "**/loading.tsx",
        "**/not-found.tsx",
        "**/default.tsx",
        "**/page.ts",
        "**/layout.ts",
        "**/template.ts",
        "**/error.ts",
        "**/global-error.ts",
        "**/loading.ts",
        "**/not-found.ts",
        "**/default.ts",
        "next.config.ts",
        "postcss.config.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["config/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/server/**/*.ts", "**/server/**/*.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["src/env/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    }
  ]
}
